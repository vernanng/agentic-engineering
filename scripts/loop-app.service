[Unit]
Description=loop-app (agentic-engineering)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/project/agentic-engineering
# .env comes from EnvironmentFile; the binary needs no launcher script.
EnvironmentFile=/root/project/agentic-engineering/.env
ExecStart=/root/project/agentic-engineering/releases/loop-app-latest
Restart=on-failure
RestartSec=2
StandardOutput=append:/root/project/agentic-engineering/loop-app.log
StandardError=append:/root/project/agentic-engineering/loop-app.log

[Install]
WantedBy=multi-user.target
