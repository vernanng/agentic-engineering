# Copy to .env (gitignored) and fill in. Never commit .env.

# Agent

JEV_MODEL=~typesafe/jev-latest

# JEV_DIR=prompt_engineering/jev

# Unset = off. 1 = labelled dev mock.
# JEV_MOCK=

# Auth

# Unset = no auth. Set = /api needs X-Loop-Token or Authorization: Bearer.
LOOP_TOKEN=

# Database

# Unset = local LOOP_DB file. Set with the token = Turso remote DB.
TURSO_DATABASE_URL=

TURSO_AUTH_TOKEN=

# LOOP_DB=loop.db

# Models

OPENROUTER_API_KEY=sk-or-...

OPENROUTER_API_BASE=https://openrouter.ai

# Unset = ambient `muse login` (dev). Set = programmatic auth for the exec/MSP
# backends; takes priority over the login file. VM-only key, never commit .env.
# META_API_KEY=

# Unset or empty = cheap tier falls back to OPENROUTER_MODEL. Example: ~deepseek/deepseek-flash-latest.
OPENROUTER_CODING_MODEL=

# OPENROUTER_ESCALATION_MODEL=openai/gpt-4o

# OPENROUTER_MAX_TOKENS=500

# OPENROUTER_MODEL=openai/gpt-4o-mini

# Server

# HOST=localhost

# Client CLI only.
# LOOP_URL=http://localhost:8000

# PORT=8000
