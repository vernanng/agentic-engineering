# Copy to .env (gitignored) and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-...
# Optional overrides (defaults shown):
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_ESCALATION_MODEL=openai/gpt-4o
# OPENROUTER_MAX_TOKENS=500
# DEEPSEEK_FLASH_MODEL= (unset/empty = cheap tier falls back to OPENROUTER_MODEL; example: ~deepseek/deepseek-flash-latest)
# JEV_MODEL=~typesafe/jev-latest
# JEV_MOCK= (unset = off; 1 = labelled dev mock)
# JEV_DIR=prompt_engineering/jev
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# LOOP_TOKEN= (unset = no auth; set = /api needs X-Loop-Token or Authorization: Bearer)
# PORT=8000
# HOST=localhost
# LOOP_DB=loop.db
# LOOP_URL=http://localhost:8000 (client CLI only)
# TURSO_DATABASE_URL= (unset = local LOOP_DB file; set with token = Turso remote DB)
# TURSO_AUTH_TOKEN=
